{
  "description": "Permanently redirect the legacy Immortalism FAQ to English",
  "expression": "(http.host in {\"humanitytomorrow.site\" \"www.humanitytomorrow.site\"} and http.request.uri.path in {\"/immortalism\" \"/immortalism/\" \"/immortalism/index.html\"})",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": { "value": "https://humanitytomorrow.site/en/immortalism/" },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
